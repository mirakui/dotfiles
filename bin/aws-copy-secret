#!/bin/bash
#
# fzf-copy-secret - Pick an AWS Secrets Manager secret and one of its JSON
# keys via fzf, then copy the chosen value to the clipboard (pbcopy).
#
# Flow:
#   1. List all secrets and pick one with fzf.
#   2. Fetch its SecretString.
#   3. If the value is a JSON object, pick a key with fzf and copy that key's
#      value; otherwise copy the whole string as-is.
#
# AWS profile/region are taken from the environment (AWS_PROFILE / AWS_REGION /
# AWS_DEFAULT_REGION etc.); no flags are passed to the aws CLI.
#
# Dependencies: aws CLI v2, jq, fzf, pbcopy (macOS)

set -uo pipefail

# --- dependency checks ------------------------------------------------------
for cmd in aws jq fzf pbcopy; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "error: required command not found: $cmd" >&2
    exit 1
  fi
done

# --- 1. pick a secret -------------------------------------------------------
# Display "Name<TAB>Description" in fzf, then keep only the Name (field 1).
selected=$(
  aws secretsmanager list-secrets --output json \
    | jq -r '.SecretList[] | [.Name, (.Description // "")] | @tsv' \
    | sort \
    | fzf --prompt='secret> ' --height=40% --reverse \
        --delimiter='\t' --with-nth='1,2'
)

if [[ -z "${selected:-}" ]]; then
  echo "aborted: no secret selected" >&2
  exit 1
fi

secret_name=$(printf '%s' "$selected" | cut -f1)

# --- 2. fetch its value -----------------------------------------------------
secret_string=$(
  aws secretsmanager get-secret-value \
    --secret-id "$secret_name" \
    --query 'SecretString' \
    --output text
)

if [[ -z "$secret_string" || "$secret_string" == "None" ]]; then
  echo "error: secret '$secret_name' has no SecretString (binary secret?)" >&2
  exit 1
fi

# --- 3. pick a key if the value is a JSON object ----------------------------
if echo "$secret_string" | jq -e 'type == "object"' >/dev/null 2>&1; then
  key=$(
    echo "$secret_string" \
      | jq -r 'keys_unsorted[]' \
      | fzf --prompt="key (${secret_name})> " --height=40% --reverse
  )
  if [[ -z "${key:-}" ]]; then
    echo "aborted: no key selected" >&2
    exit 1
  fi
  value=$(echo "$secret_string" | jq -r --arg k "$key" '.[$k]')
  label="${secret_name} / ${key}"
else
  value="$secret_string"
  label="$secret_name"
fi

# --- copy to clipboard ------------------------------------------------------
printf '%s' "$value" | pbcopy
echo "copied to clipboard: $label" >&2
